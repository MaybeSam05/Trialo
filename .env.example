# Copy to .env.local and fill in. Never commit real values.

# Supabase (server only; the service-role key never reaches the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs: the API key stays on the server and mints short-lived conversation tokens
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Clerk (coordinator accounts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/portal/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional: public base URL used in participant links and QR codes (defaults to the request's origin)
NEXT_PUBLIC_APP_URL=
